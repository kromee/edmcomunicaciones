# Dominio en producción (servidor: enlaces PDF en correos, sitemap). Sin NEXT_PUBLIC_.
# Vercel → Settings → Domains → copia el dominio de Production.
SITE_URL=https://www.tu-dominio.com

# Secreto del servidor para cifrar las claves de la app autenticadora.
# Generar con: openssl rand -base64 32
# En Vercel: Secret; nunca usar NEXT_PUBLIC_ ni incluir el valor en Git.
MFA_ENCRYPTION_KEY=
